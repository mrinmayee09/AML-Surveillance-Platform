# ---------------------------------------------------------------------------
# AML Surveillance Platform - backend environment
# Copy to `.env` and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

APP_NAME="AML Surveillance Platform"
ENVIRONMENT=demo                  # demo | development | production
DEBUG=true

# --- Database -------------------------------------------------------------
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///../database/aml.db
# PostgreSQL (production-style):
# DATABASE_URL=postgresql+psycopg2://aml_user:aml_password@localhost:5432/aml_db

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_dev_only_secret_key_do_not_use_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Risk decision thresholds (configurable, see Settings page) ------------
RISK_THRESHOLD_MEDIUM=35
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=85

# --- ML / GNN -------------------------------------------------------------
ML_MODEL_PATH=app/ml/artifacts/proactive_rf.joblib
GNN_MODEL_PATH=app/gnn/artifacts/aml_gnn.pt
GNN_ENGINE=auto                   # auto | torch | analytic
