# Frontend environment. Only NON-SECRET values belong here: everything in a
# Vite `VITE_` variable is compiled into the public bundle.
# Never put API keys, JWT secrets or database credentials in this file.

# Backend base URL. Leave blank to use the Vite dev proxy (recommended locally).
VITE_API_BASE_URL=

# Label shown in the header environment badge
VITE_ENVIRONMENT_LABEL=Demo Environment
